{
  "name": "letter-by-letter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server/main.ts & vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/*.test.ts'",
    "test:e2e": "vite build && node --test 'tests/e2e/*.test.ts'",
    "check": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.64.1",
    "preact": "^11.1.1",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.5"
  }
}
