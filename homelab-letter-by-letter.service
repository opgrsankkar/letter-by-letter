# Homelab systemd unit template for the containerized Letter by Letter.
#
# Install to: /etc/systemd/system/homelab-letter-by-letter.service
# App dir:    /srv/apps/letter-by-letter   (contains compose.yaml, Dockerfile, sources)
#
# The image MUST be built before enabling this unit: this unit never builds
# (`docker compose up -d` only), so boots stay fast and reproducible.
#   cd /srv/apps/letter-by-letter && docker compose build
#
# The original /etc/systemd/system/letter-by-letter.service is left untouched
# so rollback can simply re-enable it.

[Unit]
Description=Letter by Letter (Docker Compose)
Documentation=file:///srv/apps/letter-by-letter/DEPLOYMENT.md
Requires=docker.service
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/srv/apps/letter-by-letter

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/apps/letter-by-letter
# Bring the production stack up without rebuilding at boot.
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
